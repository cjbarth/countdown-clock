{
  "compilerOptions": {
    "allowUmdGlobalAccess": true,
    "sourceMap": true,
    "module": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "target": "es6",
    "outDir": "lib",
    "lib": ["dom", "es6"],
    "strict": true,
    "paths": {
      "@ffmpeg": ["./node_modules/@ffmpeg/ffmpeg/src/index"]
    }
  },
  "include": ["src", "types"],
  "compileOnSave": true
}
