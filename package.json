{
  "name": "countdown-clock",
  "version": "1.0.0",
  "description": "Tool to generate, and optionally download, a video of a countdown clock.",
  "main": "index.html",
  "dependencies": {},
  "devDependencies": {
    "prettier": "^2.2.1"
  },
  "scripts": {
    "build": "tsc",
    "changelog": "gren changelog --override --generate",
    "lint": "eslint --ext .ts src",
    "lint-watch": "onchange 'src/**/*.ts' -- eslint {{file}}",
    "lint:fix": "eslint --ext .ts --fix src",
    "prepare": "tsc",
    "prettier-check": "prettier --config .prettierrc.json --check .",
    "prettier-format": "prettier --config .prettierrc.json --write .",
    "prettier-watch": "onchange 'src/**/*.ts' -- prettier --write {{file}}",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tsc": "tsc",
    "tsc-watch": "tsc && tsc --watch",
    "watch": "concurrently --kill-others \"npm:*-watch\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjbarth/countdown-clock.git"
  },
  "keywords": [
    "countdown",
    "clock",
    "video"
  ],
  "author": "Chris Barth <chrisjbarth@hotmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cjbarth/countdown-clock/issues"
  },
  "homepage": "https://github.com/cjbarth/countdown-clock#readme"
}
